FIREBASE_PROJECT_ID=animeflvlite
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Modos disponibles:
# - auto: Obtiene los últimos 10 animes por "id" y actualiza metadatos + servidores
# - servers_list: Usa ANIME_LIST para actualizar animes específicos (metadatos + servidores)
MODE=servers_list
LATEST_LIMIT=3
DRY_RUN=false

SERVER_CONCURRENCY=1

FIRESTORE_COLLECTION=datos-animes
REQUEST_DELAY_MS=1500
MAX_RETRIES=3

# Solo necesario si MODE=servers_list. IDs separados por comas.
# Ejemplo: ANIME_LIST=akame-ga-kill,one-piece,naruto
ANIME_LIST=amanchu-advance,akkun-to-kanojo,alice-or-alice,aico-incarnation,animegataris,ame-iro-cocoa-series-ame-con,aho-girl,ani-ni-tsukeru-kusuri-wa-nai,alice-to-zouroku,ao-oni-the-animation-movie,acca-13-ku-kansatsu-ka,ao-no-exorcist-kyoto-fujouou-hen,akibas-trip-the-animation,ajin-part-2,all-out,ao-oni-the-animation,ame-iro-cocoa-in-hawaii,accel-world-infiniteburst,active-raid-kidou-kyoushuushitsu-dai-hachi-gakari-2nd,ange-vierge