FIREBASE_PROJECT_ID=animeflvlite
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Modos disponibles:
# - auto: Obtiene los últimos 10 animes por "id" y actualiza metadatos + servidores
# - servers_list: Usa ANIME_LIST para actualizar animes específicos (metadatos + servidores)
MODE=servers_list
LATEST_LIMIT=3
DRY_RUN=false

SERVER_CONCURRENCY=1

FIRESTORE_COLLECTION=datos-animes
REQUEST_DELAY_MS=1500
MAX_RETRIES=3

# Solo necesario si MODE=servers_list. IDs separados por comas.
# Ejemplo: ANIME_LIST=akame-ga-kill,one-piece,naruto
ANIME_LIST=bokusatsu-tenshi-dokuro-chan-2,baccano,bokura-no,blue-dragon,bakugan-battle-brawlers,byousoku-5-centimeter,busou-renkin-mahiro-no-busou-renkin-kouza,bleach-movie-1-memories-of-nobody,bartender,busou-renkin,black-lagoon-the-second-barrage,black-blood-brothers,brave-story,bokura-ga-ita,black-lagoon,binchou-tan,blood,black-cat,bouken-ou-beet-excellion,boku-wa-imouto-ni-koi-wo-suru