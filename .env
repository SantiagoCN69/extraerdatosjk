FIREBASE_PROJECT_ID=animeflvlite
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Capítulos procesados por anime en cada ejecución cuando hay más de 50.
EPISODE_BLOCK_SIZE=50
# Bloques de EPISODE_BLOCK_SIZE que puede avanzar cada anime por ejecución.
# 50 por defecto: termina animes de hasta ~2500 caps en una sola corrida.
EPISODE_BLOCKS_PER_RUN=50
# Máximo de páginas AJAX de episodios a consultar en modo metadata (16 caps/página).
MAX_EPISODE_PAGES=500
# Límite del sondeo antiguo de URLs /anime/1/../50/ si el AJAX falla.
EPISODE_PROBE_LIMIT=50

# Modos disponibles:
# - auto: Obtiene los últimos 10 animes por "id" y actualiza metadatos + servidores
# - servers_list: Usa ANIME_LIST para actualizar animes específicos (metadatos + servidores)
MODE=servers_list
LATEST_LIMIT=3
DRY_RUN=false

SERVER_CONCURRENCY=1

FIRESTORE_COLLECTION=datos-animes
REQUEST_DELAY_MS=1500
MAX_RETRIES=3

# Solo necesario si MODE=servers_list. IDs separados por comas.
# Ejemplo: ANIME_LIST=akame-ga-kill,one-piece,naruto
ANIME_LIST=bt-x-neo,black-jack-the-movie,blue-seed-2,burn-up-w,bt-x,bio-hunter,bakuretsu-hunters,blue-seed,black-jack,boku-no-chikyuu-wo-mamotte,bastard-ankoku-no-hakaishin,bubblegum-crash,burn-up,bubblegum-crisis