# Seguridad: DRY_RUN=true no escribe cambios. Revise primero esta simulación.
DRY_RUN=true

# Autenticación Admin SDK: elija UNA opción.
# Opción local: ruta al JSON de una cuenta de servicio descargada desde Firebase/GCP.
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Opción ADC: deje SERVICE_ACCOUNT_PATH vacío y defina GOOGLE_APPLICATION_CREDENTIALS,
# o ejecute en una plataforma con identidad de servicio. No incluya claves en este archivo.
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/serviceAccountKey.json
# FIREBASE_PROJECT_ID=su-project-id

FIRESTORE_COLLECTION=datos-animes
# Modos: metadata | servers_recent | servers_manual
MODE=metadata
CONCURRENCY=2
# Para actualización de servidores, 1 es el valor recomendado para no saturar JKAnime.
SERVER_CONCURRENCY=1
REQUEST_DELAY_MS=1500
MAX_RETRIES=3
PAGE_SIZE=100

# MODE=servers_recent: cantidad de documentos con fechaGuardado más reciente.
LATEST_LIMIT=10
# MODE=servers_manual: enlace de la página del anime en JKAnime.
# ANIME_URL=https://jkanime.net/nombre-del-anime/

# Proxy opcional de las estrategias originales. USE_PROXY solo si configura un proveedor.
USE_PROXY=false
# SCRAPER_API_KEY=
# ZENROWS_API_KEY=
# SCRAPEOPS_API_KEY=
